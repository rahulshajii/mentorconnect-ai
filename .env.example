# Server Port
PORT=5000

# MongoDB Database URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mentorconnect

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Application URLs
APP_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Automated Email System (SMTP Configuration)
# If left blank, email service operates in safe Simulated Dev Mode with database logging
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MentorConnect AI" <no-reply@mentorconnect.ai>
